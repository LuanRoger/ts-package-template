{
  "name": "@luanroger/ts-package-template",
  "type": "module",
  "version": "1.1.0",
  "description": "A TypeScript package template",
  "private": false,
  "author": "Luan Roger <luanroger.dev@gmail.com> (https://github.com/LuanRoger)",
  "license": "MIT",
  "homepage": "https://github.com/LuanRoger/ts-package-template",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuanRoger/ts-package-template.git"
  },
  "keywords": [
    "typescript",
    "template",
    "package",
    "rolldown",
    "vitest",
    "biome",
    "tsdown"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "scripts": {
    "dev": "tsdown --watch ./src",
    "build": "tsc && tsdown",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "changelog": "git-cliff --config ./scripts/git-cliff.toml --output CHANGELOG.md",
    "postversion": "pnpm run changelog",
    "publish": "np --package-manager npm",
    "publish:all": "pnpm run build && pnpm run publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "git-cliff": "^2.13.1",
    "lefthook": "^2.1.10",
    "np": "^12.0.0",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "ultracite": "7.9.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
}
